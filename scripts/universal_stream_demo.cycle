# 🚀 DEMO: UNIVERSAL SINGLE BINANCE FETCHING PLUGIN SCRIPT (.cycle)

# 1. Tek ve Evrensel Eklentiyi İstediğimiz Sayıda Çağırıp Yükleyelim
import plugin_binance_ws as ticker
import plugin_binance_ws as trades
import plugin_binance_ws as markprice
import plugin_binance_ws as liquidations
import plugin_paper_exchange as paper

# 2. Betik İçinden Akış (Stream) ve Sembol (Symbols) Parametrelerini Dinamik Girin
ticker.subscribe("bookTicker", "BTCUSDT", "ETHUSDT", "SOLUSDT")
trades.subscribe("aggTrade", "BTCUSDT", "SOLUSDT")
markprice.subscribe("markPrice@1s", "BTCUSDT", "ETHUSDT")
liquidations.subscribe("forceOrder", "ALL")

# 3. Çekirdek Atamaları (Core Pinning)
ticker.pin_core(0)
trades.pin_core(0)
markprice.pin_core(1)
liquidations.pin_core(1)
paper.pin_core(1)

# 4. Veri Akış Boru Hattını Bağla
pipe(ticker.best_price -> paper.market_data)

# 5. Eklentileri Başlat
ticker.start()
trades.start()
markprice.start()
liquidations.start()
paper.start()

# 6. Dinamik Strateji Eylemleri
target_symbol = "BTCUSDT"
print("🚀 Tek Evrensel Veri Çekici Başlatıldı! Hedef Sembol: " + target_symbol)

buy("BTCUSDT", qty=0.3, price=64750, leverage=20)
sell("ETHUSDT", qty=2.0, price=3110, leverage=50)

# 7. SQL Veritabanı Sorgusu
sql("SELECT * FROM mark_prices ORDER BY id DESC LIMIT 3")

log("✓ Tek Evrensel Veri Çekici Strateji Yürütmesi Başarıyla Tamamlandı.")
