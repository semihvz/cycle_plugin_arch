# 🚀 CYCLELANG HFT STRATEGY SCRIPT (.cycle)

# 1. Eklentileri Yükle
import plugin_binance_gateway as gateway
import plugin_paper_exchange as paper

# 2. Çekirdek Atamaları (Core Pinning)
gateway.pin_core(0)
paper.pin_core(1)

# 3. Veri Akış Boru Hattını Bağla
pipe(gateway.best_price -> paper.market_data)

# 4. Eklentileri Başlat
gateway.start()
paper.start()

# 5. Strateji Değişkenleri
target_symbol = "BTCUSDT"
order_qty = 0.5
leverage_val = 20

print("🚀 CycleLang Stratejisi Başlatıldı! Hedef Sembol: " + target_symbol)

# 6. Sanal Alım (Long) ve Satım (Short) Emirleri
buy("BTCUSDT", qty=0.5, price=64900, leverage=20)
sell("ETHUSDT", qty=3.0, price=3100, leverage=50)

# 7. Canlı SQL Veritabanı Sorgusu
sql("SELECT * FROM mark_prices ORDER BY id DESC LIMIT 3")

log("✓ .cycle Strateji Betiği Yürütmesi Başarıyla Tamamlandı.")
