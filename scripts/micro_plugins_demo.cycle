# 🚀 DEMO: DYNAMIC SYMBOL ATOMIC MICRO-PLUGINS SCRIPT (.cycle)

# 1. 4 Atomik Mikro-Eklentiyi ve Paper Exchange'i Yükle
import plugin_binance_ticker as ticker
import plugin_binance_trades as trades
import plugin_binance_markprice as markprice
import plugin_binance_liquidations as liq
import plugin_paper_exchange as paper

# 2. Dinamik Sembolleri Betik İçinde Belirle (HİÇBİR EKLENTİDE SABİT SEMBOL YOK)
ticker.set_symbols("BTCUSDT", "ETHUSDT", "SOLUSDT")
trades.set_symbols("BTCUSDT", "SOLUSDT")
markprice.set_symbols("BTCUSDT", "ETHUSDT")
liq.set_symbols("BTCUSDT", "ETHUSDT", "BNBUSDT")

# 3. Çekirdek Atamaları (Core Pinning)
ticker.pin_core(0)
trades.pin_core(0)
markprice.pin_core(1)
liq.pin_core(1)
paper.pin_core(1)

# 4. Veri Akış Boru Hattını Bağla
pipe(ticker.best_price -> paper.market_data)

# 5. Eklentileri Başlat
ticker.start()
trades.start()
markprice.start()
liq.start()
paper.start()

# 6. Dinamik Strateji Eylemleri
target_symbol = "SOLUSDT"
print("🚀 Atomik Mikro-Eklentiler Başlatıldı! Dinamik Sembol: " + target_symbol)

buy("BTCUSDT", qty=0.25, price=64700, leverage=20)
sell("SOLUSDT", qty=10.0, price=145, leverage=50)

# 7. SQL Veritabanı Sorgusu
sql("SELECT * FROM mark_prices ORDER BY id DESC LIMIT 3")

log("✓ Dinamik Sembollü Atomik Mikro-Eklentiler Yürütmesi Tamamlandı.")
