# 🛠️ Stage 1: Build Environment on Amazon Linux 2023
FROM amazonlinux:2023 AS builder

# Sistem Bağımlılıkları (--allowerasing curl-minimal çakışmasını çözer)
RUN dnf update -y --allowerasing && \
    dnf groupinstall "Development Tools" -y --allowerasing && \
    dnf install -y --allowerasing gcc gcc-c++ openssl-devel sqlite-devel pkgconfig curl git && \
    dnf clean all

# Rust Kurulumu (minimal profil = daha hızlı indirme)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /app

# Önce sadece Cargo dosyalarını kopyala (dependency cache)
COPY Cargo.toml Cargo.lock ./
COPY orchestrator/Cargo.toml orchestrator/Cargo.toml
COPY ohlcv_fetcher/Cargo.toml ohlcv_fetcher/Cargo.toml
COPY ms_analyzer/Cargo.toml ms_analyzer/Cargo.toml
COPY ms_analyzer/ohlcv-engine/Cargo.toml ms_analyzer/ohlcv-engine/Cargo.toml
COPY binance_trader/Cargo.toml binance_trader/Cargo.toml
COPY plugin_breakout/Cargo.toml plugin_breakout/Cargo.toml
COPY oi_fetcher/Cargo.toml oi_fetcher/Cargo.toml
COPY flow_engine/Cargo.toml flow_engine/Cargo.toml
COPY plugin_paper_exchange/Cargo.toml plugin_paper_exchange/Cargo.toml
COPY binance_gateway/Cargo.toml binance_gateway/Cargo.toml
COPY plugin_scout/Cargo.toml plugin_scout/Cargo.toml
COPY plugin_binance_sqlite/Cargo.toml plugin_binance_sqlite/Cargo.toml
COPY plugin_sqlite_query/Cargo.toml plugin_sqlite_query/Cargo.toml
COPY plugin_aggtrade_stats/Cargo.toml plugin_aggtrade_stats/Cargo.toml
COPY plugin_aggtrade_ohlcv/Cargo.toml plugin_aggtrade_ohlcv/Cargo.toml
COPY plugin_sys_metrics/Cargo.toml plugin_sys_metrics/Cargo.toml
COPY plugin_binance_ws/Cargo.toml plugin_binance_ws/Cargo.toml
COPY interactive_shell/Cargo.toml interactive_shell/Cargo.toml

# Tüm kaynak kodları kopyala
COPY . .

# Release Derlemesi
RUN cargo build --release

# 🚀 Stage 2: Runtime Environment on Amazon Linux 2023
FROM amazonlinux:2023

RUN dnf install -y --allowerasing openssl sqlite libgcc && \
    dnf clean all

WORKDIR /app

# Derlenen Binary ve Eklentileri Kopyala
COPY --from=builder /app/target/release/cycle-finance-breakout-system /app/
COPY --from=builder /app/target/release/libplugin_*.so /app/
COPY --from=builder /app/flow_config.json /app/

ENV RUST_LOG=info

ENTRYPOINT ["./cycle-finance-breakout-system"]
